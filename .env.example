# ---------------------------------------------------------------------------
# Atmosphere — environment configuration
#
# 1. Copy this file to `.env`  (cp .env.example .env)
# 2. Paste your key from https://home.openweathermap.org/api_keys
# 3. Run `npm start`
#
# `.env` is listed in .gitignore and must NEVER be committed.
# ---------------------------------------------------------------------------

# Your OpenWeatherMap API key (free "Current Weather" + "5 Day / 3 Hour Forecast").
OPENWEATHER_API_KEY=your_api_key_here

# Optional: route requests through a server-side proxy instead of calling
# OpenWeatherMap directly from the browser. When set, the browser never sees
# the key. Used automatically by the Netlify deployment (see README).
# API_PROXY_URL=/.netlify/functions/owm

# Optional: port for the local dev server (default 5500).
# PORT=5500
